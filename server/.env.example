# OfficeGest backend — environment template.
#
# ▶ COPY THIS FILE TO `server/.env` AND FILL IT IN THERE.
#
#   cp server/.env.example server/.env
#
# THIS FILE IS NEVER LOADED. Node reads `.env`, not `.env.example` — a value
# written here does nothing except get committed. `server/.env` is gitignored;
# this template is committed, so it MUST NEVER CONTAIN A REAL VALUE.
#
# UNLIKE THE ANGULAR `.env` AT THE REPOSITORY ROOT, THE VALUES IN `server/.env`
# ARE SECRET. The root `.env` is compiled into the browser bundle through an
# allow-list in `scripts/lib/env.mjs`. Nothing in `server/.env` goes near that
# pipeline: it is read at runtime by the Node process and never leaves it.
#
# Load order, last one wins:
#   ../.env  →  ../.env.local  →  server/.env  →  server/.env.local
#
# The repository-root files are read first, so a variable set there still works.
# `server/.env` is preferred because it keeps the credential out of the file
# that feeds the browser build.

# ── OfficeGest ───────────────────────────────────────────────────────────────

# Your tenant's API base URL, including the version segment. REQUIRED.
#   v2: https://YOUR-COMPANY.officegest.com/api/v2
#   v1: https://YOUR-COMPANY.officegest.com/api
OFFICEGEST_BASE_URL="https://fsautomotivelda.officegest.com/api/v2"

# How to authenticate. Exactly one of these three spellings:
#
#   bearer-login  (default, OfficeGest v2) — POST /auth/login with username and
#                 password, then send the returned token as a Bearer header.
#                 The token is cached and renewed automatically.
#   basic         (OfficeGest v1) — HTTP Basic with the same username and
#                 password.
#   static-token  — send OFFICEGEST_API_KEY as `Authorization: Bearer <key>`.
#                 NOT a documented OfficeGest mechanism; use it only if your
#                 tenant issued you a ready-made token. See the README.
#
# `bearer` is not a valid value — the full name is `bearer-login`.
OFFICEGEST_AUTH_MODE=bearer-login

# The API user OfficeGest issued for this integration.
# REQUIRED for `bearer-login` and `basic`; ignored by `static-token`.
OFFICEGEST_USERNAME="DES@DES"

# That user's password. REQUIRED for `bearer-login` and `basic`.
# OFFICEGEST_API_KEY is accepted in its place; when both are set, this wins.
OFFICEGEST_PASSWORD="API20262026"

# REQUIRED for `static-token` (it is the token itself). Otherwise optional —
# a fallback for OFFICEGEST_PASSWORD, because integrators habitually call the
# API user's secret "the API key".
OFFICEGEST_API_KEY="14217|c102beb0ad6af8d3055605128fed0c2c43a044e0ee6eec7a4558b1b98adc7dbf525ec18c35a8c28f"

# Per-attempt timeout in milliseconds. Default 10000.
OFFICEGEST_TIMEOUT_MS=10000

# Extra attempts after the first, for transient failures only (timeouts,
# connection errors, 5xx, 429). Default 2. Set 0 to disable retries.
OFFICEGEST_MAX_RETRIES=2

# ── This service ─────────────────────────────────────────────────────────────

# Default 3000.
PORT=3000

# development | test | production. Default development.
# `production` refuses a plain-http OFFICEGEST_BASE_URL and hides internal error
# messages from responses.
NODE_ENV=development

# debug | info | warn | error | silent. Default info.
LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API.
# Empty means no browser origin is allowed — set it before the site can call in.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Comma-separated keys that callers of THIS service must send in `x-api-key`.
# Empty disables the guard — only safe when the service is not publicly
# reachable. These are unrelated to OFFICEGEST_API_KEY: a leak here exposes this
# API's read endpoints, never the client's ERP. List several to rotate one at a
# time.
BACKEND_API_KEYS=

# Per-client request cap, to protect the upstream quota. Defaults: 60000 / 120.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
