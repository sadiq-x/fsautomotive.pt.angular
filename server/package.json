{
  "name": "@fsautomotive/officegest-backend",
  "version": "1.0.0",
  "description": "Backend service that brokers requests between the FS Automotive site and the OfficeGest API.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local ./node_modules/.bin/tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local ./node_modules/.bin/tsx scripts/probe.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
