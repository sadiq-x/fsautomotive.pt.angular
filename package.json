{
  "name": "fsautomotive",
  "version": "1.0.0",
  "description": "Website institucional da FS Automotive \u2014 oficina autom\u00f3vel multimarca em Vialonga.",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.2.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "install:all": "npm install && npm --prefix server install",
    "start": "node scripts/dev.mjs",
    "start:web": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ng-env.mjs serve",
    "start:api": "npm --prefix server run dev",
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ng-env.mjs build",
    "watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ng-env.mjs build --watch --configuration development",
    "test": "ng test",
    "test:scripts": "node --test scripts/lib/env.test.mjs",
    "deploy": "npm run build:ghpages && ng deploy --no-build",
    "test:watch": "ng test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run test && npm run test:scripts && npm run build",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "verify:full": "npm run verify && npm run audit:responsive",
    "build:ghpages": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ng-env.mjs build --base-href=/fsautomotive.pt.angular/"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
