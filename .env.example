# Copy to `.env` and fill in. `.env` is gitignored; this template is committed,
# so it must never contain a real value.
#
# `.env.local` is read after `.env` and overrides it — use it for a personal
# value you do not want to share, and leave `.env` as the team default.
#
# Variables here are compiled into the browser bundle by scripts/ng-env.mjs and
# are publicly readable — never put a secret in this file. Only names on the
# allow-list in that script are exposed.

# Google Analytics 4 Measurement ID.
# Admin → Data Streams → your web stream. Leave empty to disable analytics.
# Use a separate GA4 property for local development so dev traffic does not
# land in the client's production reports.
# A malformed value fails the production build rather than shipping a site
# that silently reports nothing.
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Optional kill switch. Leave empty to follow the Measurement ID above.
# Set to `false` to build with analytics off while keeping the ID configured —
# for a staging deploy that must not report into the client's property.
GOOGLE_ANALYTICS_ENABLED=YES

# URL do backend próprio (o serviço em `server/`).
# Vazio = mesma origem da página, que é o que uma configuração com proxy quer.
# Em desenvolvimento, o backend corre em http://localhost:3000.
# Isto é um endereço, não um segredo.
API_BASE_URL=http://localhost:3000

# Stub de autenticação para desenvolvimento.
# Com `true`, /private/login aceita QUALQUER palavra-passe — serve para
# trabalhar na área de gestão sem ter o backend a correr. O início de sessão a
# sério vive em `server/` (ver AUTH_USERS_FILE em `server/.env.example`).
# O build de produção falha se esta variável estiver ativa (ver
# `checkDevAuthStub` em scripts/lib/env.mjs). Deixe vazio para usar o backend.

##DEV_AUTH_STUB=YES